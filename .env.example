# 复制为 .env 后填写（本地运行用；GitHub 上请改用 Secrets）
# 推送 Gist 必填：具有 gist 权限的 GitHub Personal Access Token
GIST_TOKEN=

# 目标 Gist ID（留空则首次运行自动新建一个公开 Gist，新建后把返回的 id 填回来）
GIST_ID=

# 写入 Gist 的文件名（网页端默认读 feed.json）
GIST_FILENAME=feed.json

# 可选：启用真正的 AI 改写（不填则用模板+真实热榜回落）
OPENAI_API_KEY=
# OpenAI 兼容接口地址（可用第三方或自建，默认官方）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
